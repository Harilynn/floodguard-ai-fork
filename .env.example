# Backend secrets. Set these in the backend hosting provider, never in Git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-rotated-secret-key
SUPABASE_FLOODGAURD_URL=https://your-operations-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-rotated-service-role-key
LYZR_API_KEY=replace-with-rotated-lyzr-key
LYZR_AGENT_ID=your-lyzr-agent-id
LYZR_USER_ID=floodguard
GOOGLE_MAPS_API_KEY=replace-with-restricted-google-key
GEMINI_API_KEY=replace-with-rotated-gemini-key
GEMINI_MODEL=gemini-2.5-flash
THINGSPEAK_CHANNEL_ID=your-channel-id
THINGSPEAK_READ_API_KEY=replace-with-rotated-read-key
FRONTEND_ORIGINS=http://localhost:3000

# Frontend variable. Set this in Vercel to the deployed backend URL.
NEXT_PUBLIC_FLOODGAURD_API_URL=http://127.0.0.1:8000